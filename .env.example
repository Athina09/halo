# No secrets here. Real keys live in Keyward's vault.
KEYWARD_URL=http://127.0.0.1:8787
KEYWARD_AGENT_TOKEN=            # from `keyward token agent`
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=any-string-you-chose
OWNER_NUMBER=919876543210       # country code, digits only
ALLOWED_NUMBERS=                # up to 4 friends, comma separated; owner is always allowed
HALO_DB=halo.db

OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_TIMEOUT=20

# Phone calls (phase 4). Needs a public https address (cloudflared) and a Twilio number.
HALO_PUBLIC_URL=                # e.g. https://xxxx.trycloudflare.com (no trailing slash)
TWILIO_ACCOUNT_SID=             # starts with AC; not secret. The auth token goes into Keyward only.
TWILIO_FROM=                    # your Twilio number, +country code
